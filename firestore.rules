rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.fullName is string &&
             data.fullName.size() >= 1 &&
             data.fullName.size() <= 120 &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 200;
    }

    // User Profile collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Deny public user enumeration
      
      allow create: if isOwner(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.keys().hasAll(['uid', 'fullName', 'email']) &&
                       request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt']);
                       
      allow update: if isOwner(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'email']);
                       
      allow delete: if false;
    }
  }
}
